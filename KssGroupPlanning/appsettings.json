{
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": "Information",
        "Override": {
            "Microsoft": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.AspNetCore": "Information",
            "Quartz": "Information",
            "KssGroupPlanning.Services.EntityServices": "Debug",
            "KssGroupPlanning.Services.IntergrationServices": "Information",
            "KssGroupPlanning.Services.CoreService": "Debug",
            "KssGroupPlanning.Repositories": "Warning"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/app-.txt",
                    "rollingInterval": "Day",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}",
                    "retainedFileCountLimit": 30,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true
                }
            }
        ]
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "ProjectDbContext": "User id=postgres;Password=12345678;Server=localhost;Port=5432;Database=kssgroup3;"
        //"ProjectDbContext": "User id=postgres;Password=12345678;Server=localhost;Port=5432;Database=kssgroup;"
        //"ProjectDbContext": "User id=admin;Password=admin;Server=195.133.48.157;Port=5432;Database=kssgroup;"
    },

    "AllowedHosts": "*",
    "JwtOptions": {
        "SecretKey": "kssgroup",
        "Audience": "audience",
        "Issuer": "issuer",
        "ExpiresHours": "12"
    }
}